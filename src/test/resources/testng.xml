<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name = "OrangeHRMSuite" parallel = "tests" thread-count = "8">


<test name = "OrangeHRMTest_Chrome">
<parameter name="browser" value="Chrome"/>
<classes>
		<class name = "com.orangehrm.test.HomePageTest"></class>
		<class name = "com.orangehrm.test.DBVerificationTest"></class>
		<class name = "com.orangehrm.test.DummyTest2"></class>
</classes>
</test>

<test name = "OrangeHRMTest_Edge">
<parameter name="browser" value="Edge"/>
<classes>
		<class name = "com.orangehrm.test.HomePageTest"></class>
		<class name = "com.orangehrm.test.DBVerificationTest"></class>
		<class name = "com.orangehrm.test.DummyTest2"></class>
</classes>
</test>



</suite>
